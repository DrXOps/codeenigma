import os
import sys
import subprocess
from setuptools import find_packages, setup
from setuptools.extension import Extension
from Cython.Build import cythonize

is_macos = sys.platform == "darwin"
is_windows = sys.platform == "win32"

if is_windows:
    # MSVC (cl.exe) does not understand GCC-style flags at all — passing them
    # errors out before compilation even starts. Fork patch: upstream only
    # branched on is_macos and left Windows with the GCC flags below, which
    # is a second bug on top of the *.so/*.pyd one this fork also fixes.
    extra_compile_args = ["/O2"]
    extra_link_args = []
else:
    extra_compile_args = [
        "-O3",
        "-fPIC",
        "-fvisibility=hidden",
        "-fdata-sections",
        "-ffunction-sections",
        "-flto",
    ]

    extra_link_args = []

    if not is_macos:
        # Linux-only flags
        extra_link_args += [
            "-Wl,--gc-sections",
            "-Wl,--strip-all"
        ]
    else:
        # macOS-safe alternatives (strip done manually later)
        pass  # macOS will error on unknown linker flags

# Define extension
ext = Extension(
    name="codeenigma_runtime",
    sources=["codeenigma_runtime.pyx"],
    extra_compile_args=extra_compile_args,
    extra_link_args=extra_link_args,
    language="c",
)

setup(
    name="codeenigma_runtime",
    version=$version,
    ext_modules=cythonize(
        [ext],
        compiler_directives={
            "language_level": "3",
            "boundscheck": False,
            "wraparound": False,
            "initializedcheck": False,
            "nonecheck": False,
            "cdivision": True,
            "c_string_type": "str",
            "c_string_encoding": "utf8",
        },
        nthreads=4,
    ),
    packages=find_packages(),
    zip_safe=False,
)

if is_windows:
    # MSVC produces a *.pyd, not a *.so, and there is no "strip" tool on
    # Windows by default (unless MSYS/MinGW is installed) — the binary is
    # already stripped by the linker via /OPT:REF /OPT:ICF-equivalent
    # defaults, so skip this step entirely rather than let it silently
    # no-op via the broad except below (which previously masked the real
    # *.so vs *.pyd bug in bundler/poetry.py's create_extension).
    print("Skipping strip step on Windows (no *.so produced, no strip tool)")
else:
    try:
        so_file = next(p for p in os.listdir('.') if p.startswith("codeenigma_runtime") and p.endswith(".so"))
        print(f"Stripping binary: {so_file}")
        subprocess.run(["strip", "-x", so_file], check=True)
    except Exception as e:
        print(f"[Warning] Could not strip shared object: {e}")
